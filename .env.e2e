# Изолированное окружение браузерных тестов. Здесь только локальные сервисы из docker-compose.yml.
NODE_ENV=production
PORT=4300
APP_URL=http://localhost:4300
TRUSTED_PROXY_HOPS=1

DATABASE_URL=postgres://uyut:uyut@localhost:5432/uyut
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local-dev-token

S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-1
S3_BUCKET=uyut-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

BETTER_AUTH_SECRET=e2e-only-secret-that-is-at-least-32-characters
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM=Домица E2E <e2e@domitsa.local>
MAILPIT_URL=http://localhost:8025

# Никаких внешних вызовов, ошибок в Sentry и настоящих платежей во время E2E.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=local-e2e
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local-e2e
FAL_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
TRIGGER_SECRET_KEY=
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
YUKASSA_API_URL=
