# Локальная разработка. Скопируйте в .env — значения ниже совпадают с docker-compose.yml.

# PostgreSQL 17 + pgvector
DATABASE_URL=postgres://uyut:uyut@localhost:5432/uyut

# Redis через REST-прокси serverless-redis-http (совместим с клиентами Upstash)
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local-dev-token

# S3-совместимое хранилище (MinIO локально, Selectel в проде)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-1
S3_BUCKET=uyut-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Порт dev-сервера и публичный адрес приложения. Порт можно менять, если 4300 занят.
PORT=4300
APP_URL=http://localhost:4300

# Sentry. Пустое значение = SDK выключен.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
