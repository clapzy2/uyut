# Локальная разработка. Скопируйте в .env — значения ниже совпадают с docker-compose.yml.

# PostgreSQL 17 + pgvector
DATABASE_URL=postgres://uyut:uyut@localhost:5432/uyut

# Redis через REST-прокси serverless-redis-http (совместим с клиентами Upstash)
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local-dev-token

# S3-совместимое хранилище (MinIO локально, Selectel в проде)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-1
S3_BUCKET=uyut-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Порт dev-сервера и публичный адрес приложения. Порт можно менять, если 4300 занят.
PORT=4300
APP_URL=http://localhost:4300

# Сколько своих обратных прокси стоит перед приложением. За Coolify — 1: доверяем последней
# записи X-Forwarded-For, всё, что клиент дописал перед ней, игнорируется. 0 = прокси нет,
# заголовку не верим вовсе и адрес клиента в аудит не попадает.
TRUSTED_PROXY_HOPS=1

# Sentry. Пустое значение = SDK выключен.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Better Auth: секрет для подписи cookie и токенов, не короче 32 символов. Сгенерировать: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Почта. Локально письма ловит Mailpit из docker-compose: SMTP 1025, веб-интерфейс http://localhost:8025
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM=Домица <hello@domitsa.ru>
MAILPIT_URL=http://localhost:8025

# Fal.ai: генерация рендеров комнат. Ключ в кабинете fal.ai, раздел API Keys.
FAL_KEY=
# Движок генерации: nano-banana-2 (основной) или kontext-pro (запасной).
CONCEPT_MODEL=nano-banana-2

# Anthropic: Claude собирает задание для рендера и переводит пожелания с русского.
# Пусто = работает шаблонный сборщик без перевода. console.anthropic.com → API keys.
ANTHROPIC_API_KEY=

# Voyage AI: embeddings для подбора мебели в следующей фазе. Пусто = сервис не используется.
VOYAGE_API_KEY=

# Trigger.dev: ключ окружения для постановки задач из приложения. Пусто = генерация недоступна.
TRIGGER_SECRET_KEY=

# Товарные фиды Admitad в формате YML. Источник берётся из имени переменной: OZON, WB, HOFF, DIVAN, ASKONA, LEROY, IKEA.
# Ссылка содержит ключ, поэтому живёт только здесь. Пусто = ночная индексация только пересчитывает векторы.
ADMITAD_FEED_OZON_URL=
ADMITAD_FEED_HOFF_URL=

# Смета: ориентировочная стоимость работ, рублей за м². Черновые считаются для комнат в черновой
# отделке, чистовые — для них же и для готовых комнат с включённым «обновить отделку».
WORKS_ROUGH_RUB_PER_M2=15000
WORKS_FINISH_RUB_PER_M2=5000

# Срок подписанной ссылки на PDF в часах (не больше 168: ограничение подписи S3).
PDF_URL_TTL_HOURS=168

# ЮKassa: shopId и секретный ключ магазина (для разработки — тестового, ключ начинается с test_).
# Пусто = фейковый провайдер: оплата проходит сразу, без редиректа. Кабинет → Интеграция → Ключи API.
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
# Адрес API: пусто = https://api.yookassa.ru/v3; переопределяется только для тестов.
YUKASSA_API_URL=
# Цены в копейках: разовая покупка проекта и подписка Pro в месяц.
PROJECT_PRICE_KOPECKS=150000
PRO_PRICE_KOPECKS=99900

# Секрет для дневного прохода по подпискам: им расписание Trigger.dev будит /api/cron/subscriptions.
# Пусто = автопродление не работает, маршрут отвечает 404. Сгенерировать: openssl rand -hex 32
CRON_SECRET=

# PostHog: аналитика продукта. Пусто = аналитика выключена, библиотека даже не грузится.
# Ключ в кабинете: Project Settings → Project API Key. Регион EU.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
