{
  "name": "@uyut/jobs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../.env run trigger dev",
    "deploy": "trigger deploy",
    "typecheck": "tsc --noEmit",
    "catalog:gdeslon": "bun --env-file=../.env run scripts/fetch-gdeslon.ts",
    "catalog:import": "bun --env-file=../.env run scripts/import-catalog.ts",
    "catalog:repair-dimensions": "bun --env-file=../.env run scripts/repair-dimensions.ts",
    "catalog:repair-subcategories": "bun --env-file=../.env run scripts/repair-subcategories.ts",
    "bench-crop": "bun --env-file=../.env run scripts/bench-crop.ts",
    "catalog:embed": "bun --env-file=../.env run scripts/embed-catalog.ts",
    "try-match": "bun --env-file=../.env run scripts/try-match.ts",
    "match-concept": "bun --env-file=../.env run scripts/match-concept.ts",
    "index-now": "bun --env-file=../.env run scripts/index-catalog-now.ts"
